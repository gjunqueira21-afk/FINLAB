# ---------------------------------------------------------------------------
# Gab's FinLab — copie para finlab/.env e ajuste. Este arquivo NÃO vai ao git.
# ---------------------------------------------------------------------------

# Cotações intradiárias, consenso de analistas e beta de mercado.
# Sem token o painel continua funcionando com PulseFlat (fechamento D-1) +
# CVM, apenas sem preço em tempo real. Token gratuito: https://brapi.dev
BRAPI_TOKEN=

# Onde estão os parquets do pipeline CVM. O padrão aponta para
# ../valuation_cvm/data/processed, que é onde o pipeline deste repositório grava.
# FINLAB_CVM_DIR=

# Servidor local
FINLAB_HOST=127.0.0.1
FINLAB_PORT=8777

# Tempo de vida do cache, em segundos
# FINLAB_TTL_QUOTE=300
# FINLAB_TTL_HISTORY=3600
# FINLAB_TTL_FUND=43200
# FINLAB_TTL_MACRO=3600
# FINLAB_TTL_CVM=86400

# As chaves dos modelos de IA NÃO ficam aqui: são cadastradas na própria
# interface (⚙ Modelos de IA) e guardadas no localStorage do navegador.
